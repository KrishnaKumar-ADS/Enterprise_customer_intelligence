# Local secrets and environment configuration
.env
.env.*
!.env.example

# Datasets and data products
data/
*.csv
*.tsv
*.xlsx
*.xls
*.parquet
*.feather
*.sqlite
*.sqlite3
*.db
*.pkl
*.pickle

# Trained models and serialized artifacts
models/
*.joblib
*.h5
*.hdf5
*.onnx
*.pt
