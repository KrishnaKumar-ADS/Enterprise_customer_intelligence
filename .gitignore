# Configuration is source code and should be committed.
configs/*
!configs/
!configs/**/*.yaml
!configs/**/*.yml

# Runtime logs, temporary files, and local backups
*.log
*.tmp
*.temp
*.bak
*.bak_*
*_backup_*
*~

# Database and experiment metadata generated by tuning runs
optuna/
wandb/
mlruns/
